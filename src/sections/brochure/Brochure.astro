---
import { Image } from "astro:assets";
import Icon from '../../components/Icon.astro';
import BrochureImage from "../../assets/images/Brochure/brochure.webp";
---

<section id="quienes-somos" class="bg-white py-16">
  <div class="mx-auto grid max-w-6xl items-center gap-12 px-6 md:grid-cols-2">

    <div>
      <p class="flex items-center gap-3 text-xs font-bold uppercase tracking-wide text-navy-900">
        <span class="h-0.5 w-9 bg-brand-500"></span>
        ¿Quiénes somos?
      </p>

      <h2 class="mt-4 text-3xl font-extrabold leading-tight text-navy-800 md:text-[34px]">
        Comprometidos con<br />
        la energía de tu hogar<br />
        y empresa
      </h2>

      <p class="mt-4 max-w-sm text-[15px] leading-relaxed text-slate-500">
        Somos una empresa especializada en trabajos eléctricos, con un equipo técnico calificado
        y experiencia en proyectos residenciales, comerciales e industriales.
      </p>

      <a
        href="#proyectos"
        class="mt-6 inline-flex items-center gap-2 rounded-lg border-2 border-navy-800 px-6 py-2.5 text-sm font-semibold text-navy-800 transition hover:bg-navy-800 hover:text-white"
      >
        Conoce más
        <Icon name="arrow-right" class="w-4 h-4" />
      </a>
    </div>

    <div class="relative mr-6 mb-6">

      <!-- Bloque naranja decorativo -->
      <div class="absolute -bottom-6 -right-6 left-24 top-8 rounded-2xl bg-brand-500"></div>

      <!-- Imagen del brochure -->
      <Image
        src={BrochureImage}
        alt="Brochure de Proyectos y Servicios Generales YELE S.A.C."
        class="relative aspect-[1.77] w-full rounded-2xl object-cover shadow-lg"
        format="webp"
      />

      <!-- Información -->
      <div
        class="absolute -right-6 top-20 flex items-center gap-4 rounded-2xl bg-navy-800 px-6 py-5 text-white shadow-xl"
      >
        <Icon name="zap" class="h-9 w-9" />

        <ul class="text-sm font-semibold leading-snug">
          <li>Eficiencia</li>
          <li>Seguridad</li>
          <li>Confianza</li>
        </ul>
      </div>

    </div>

  </div>
</section>