---
import { Image } from "astro:assets";
import Icon from '../../components/Icon.astro';
import H1 from "../../assets/images/Hero/Slider1.webp";
---

<section id="inicio" class="relative isolate min-h-[600px] overflow-hidden bg-navy-900">

  <!-- Imagen -->
  <Image
    src={H1}
    alt="Técnico electricista trabajando en un tablero eléctrico"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-right"
    format="webp"
  />

  <!-- Oscurecimiento -->
  <div class="absolute inset-0 -z-10 bg-gradient-to-r from-navy-900 via-navy-900/85 to-transparent"></div>

  <div class="mx-auto flex min-h-[600px] max-w-6xl flex-col justify-center px-6 py-16">

    <p class="text-sm font-bold uppercase tracking-wide text-brand-500">
      Soluciones eléctricas
    </p>

    <h1 class="mt-2 text-4xl font-extrabold leading-tight text-white md:text-6xl">
      Energía que<br />
      impulsa <span class="text-brand-500">tus proyectos</span>
    </h1>

    <p class="mt-5 max-w-md text-[15px] leading-relaxed text-white/90">
      Instalaciones eléctricas, mantenimiento y proyectos a la medida de tus necesidades.
      Seguridad, eficiencia y compromiso en cada trabajo.
    </p>

    <a
      href="#quienes-somos"
      class="mt-7 inline-flex w-fit items-center gap-2 rounded-lg bg-brand-500 px-7 py-3 text-sm font-semibold text-white transition hover:bg-brand-600"
    >
      Conoce más
      <Icon name="arrow-right" class="h-4 w-4" />
    </a>

  </div>
</section>