---
import { Image } from "astro:assets";
import logo from "../assets/images/Navbar/Logo_webp.webp";
import Icon from "./Icon.astro";

const links = [
  { label: 'Inicio', href: '#inicio' },
  { label: 'Proyectos', href: '#proyectos' },
  { label: 'Servicios', href: '#servicios' },
  { label: 'Aliados', href: '#aliados' },
];
---

<header class="sticky top-0 z-50 bg-white/95 backdrop-blur border-b border-slate-100">
  <div class="mx-auto flex h-[76px] max-w-6xl items-center justify-between px-6">
    <a href="/" class="flex items-center gap-2.5">
      <Image
        src={logo}
        alt="Logo"
        class="h-15 w-25"
        format="webp"
      />
    </a>

    <nav class="hidden md:flex items-center gap-10 text-sm font-semibold text-navy-900">
      {
        links.map((l, i) => (
          <a
            href={l.href}
            class:list={[
              'relative py-1 transition-colors hover:text-brand-500',
              i === 0 && 'text-brand-500 after:absolute after:left-0 after:-bottom-1 after:h-0.5 after:w-full after:bg-brand-500',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <a
      href="#contacto"
      class="hidden md:inline-flex items-center gap-2 rounded-lg bg-navy-800 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-navy-900"
    >
      Contactar <Icon name="arrow-right" class="w-4 h-4" />
    </a>

